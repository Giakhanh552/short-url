# Application
NODE_ENV=production
HOST=127.0.0.1
PORT=3080

# PostgreSQL (listen on 127.0.0.1 only)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=urlshortener
DB_USER=urlapp
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Public site (used in docs / health checks)
# DOMAIN=shortly.example.com

# Discord webhook for Alertmanager (also set DISCORD_WEBHOOK_URL in GitHub Secrets for CI)
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
